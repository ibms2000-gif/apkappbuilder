{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apkappbuilder",
  "account_id": "1af045031826254cba5e2039a6454347",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*","/control/*","/admin.html","/app/*"]},
  "observability": {"enabled":true,"traces":{"enabled":true}},
  "vars": {
    "GITHUB_REPOSITORY":"ibms2000-gif/apkappbuilder","GITHUB_REF":"main",
    "GROQ_MODEL":"openai/gpt-oss-20b","GEMINI_MODEL":"gemini-3.8-flash","AI_PROVIDER":"auto",
    "DEVICE_DAILY_LIMIT":"2","GROQ_DAILY_REQUEST_CAP":"40","GEMINI_DAILY_REQUEST_CAP":"40"
  },
  "d1_databases":[{"binding":"DB","database_name":"apkappbuilder-db","database_id":"d3668dd1-7aea-4e21-a11b-6f264039faec","migrations_dir":"migrations"}]
}